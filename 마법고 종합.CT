  <UserdefinedSymbols/>
  <LuaScript>-- 전역 변수 초기화
if macroTimer2 then
  macroTimer2.destroy()
end

macroTimer2 = createTimer()
macroTimer2.Interval = 100
macroTimer2.Enabled = false

running2 = false
roundsCompleted = {}
firstRoundDetected = false
startRound = -1

-- 좌표 읽기 함수
local function readPosition()
  local posX = readFloat("pb+18")
  local posY = readFloat("pb+1C")
  if posX and posY then
    return posX, posY
  end
  return nil, nil
end

-- 좌표 비교 함수 (오차범위 제거: 정확히 일치할 때만 true)
local function checkCoordinatesExact(targetX, targetY)
  local posX, posY = readPosition()
  if not posX or not posY then
    return false
  end
  return (posX == targetX) and (posY == targetY)
end

-- 좌표 쓰기(바이트로 정확히 기록)
local function writePositionBytes(b1, b2, b3, b4, b5, b6, b7, b8)
  writeBytes("pb+18", b1, b2, b3, b4)
  writeBytes("pb+1C", b5, b6, b7, b8)
end

-- 1 라운드 처리: 1초 뒤 (26, 87)
local function handleRound1()
  local delay = createTimer()
  delay.Interval = 1000
  delay.OnTimer = function(t)
    -- (26, 87) -&gt; 00 00 D0 41 | 00 00 AE 42
    writePositionBytes(0x00, 0x00, 0xD0, 0x41, 0x00, 0x00, 0xAE, 0x42)
    t.Enabled = false
    t.destroy()
  end
  delay.Enabled = true
end

-- 2 라운드 처리: 1초 뒤 (116, 100)
local function handleRound2()
  local delay = createTimer()
  delay.Interval = 1000
  delay.OnTimer = function(t)
    -- (116, 100) -&gt; 00 00 E8 42 | 00 00 C8 42
    writePositionBytes(0x00, 0x00, 0xE8, 0x42, 0x00, 0x00, 0xC8, 0x42)
    t.Enabled = false
    t.destroy()
  end
  delay.Enabled = true
end

-- 3 라운드 처리: 1초 뒤 (168, 27)
local function handleRound3()
  local delay = createTimer()
  delay.Interval = 1000
  delay.OnTimer = function(t)
    -- (168, 27) -&gt; 00 00 28 43 | 00 00 D8 41
    writePositionBytes(0x00, 0x00, 0x28, 0x43, 0x00, 0x00, 0xD8, 0x41)
    t.Enabled = false
    t.destroy()
  end
  delay.Enabled = true
end

-- 4 라운드 처리: 1초 뒤 (14, 8)
local function handleRound4()
  local delay = createTimer()
  delay.Interval = 1000
  delay.OnTimer = function(t)
    -- (14, 8) -&gt; 00 00 60 41 | 00 00 00 41
    writePositionBytes(0x00, 0x00, 0x60, 0x41, 0x00, 0x00, 0x00, 0x41)
    t.Enabled = false
    t.destroy()
  end
  delay.Enabled = true
end

-- 라운드 감지 함수 (정확 일치)
local function detectRound()
  local roundCoords = {
    {136.0, 86.0, 1, "1 라운드"}, -- 00 00 08 43 | 00 00 AC 42
    {16.0, 14.0, 2, "2 라운드"},  -- 00 00 80 41 | 00 00 60 41
    {25.0, 21.0, 3, "3 라운드"},  -- 00 00 C8 41 | 00 00 A8 41
    {14.0, 16.0, 4, "4 라운드"},  -- 00 00 60 41 | 00 00 80 41
  }

  for _, data in ipairs(roundCoords) do
    local x, y, roundNum = data[1], data[2], data[3]
    if checkCoordinatesExact(x, y) then
      if not firstRoundDetected then
        firstRoundDetected = true
        startRound = roundNum
        for r = 1, roundNum - 1 do
          roundsCompleted[r] = true
        end
      end

      local lastKey = "last_" .. roundNum
      local now = os.clock()
      if not roundsCompleted[lastKey] or (now - roundsCompleted[lastKey] &gt;= 10) then
        roundsCompleted[lastKey] = now
        if roundNum == 1 then
          handleRound1()
        elseif roundNum == 2 then
          handleRound2()
        elseif roundNum == 3 then
          handleRound3()
        elseif roundNum == 4 then
          handleRound4()
          local resetTimer = createTimer()
          resetTimer.Interval = 5000
          resetTimer.OnTimer = function(t)
            roundsCompleted = {}
            firstRoundDetected = false
            startRound = -1
            t.Enabled = false
            t.destroy()
          end
          resetTimer.Enabled = true
        end
      end
      return true
    end
  end
  return false
end

-- 메인 타이머
macroTimer2.OnTimer = function()
  if not running2 then return end
  detectRound()
end

-- 기존 항목 찾기 (중복 방지)
local addressList = getAddressList()
local existingRecord = addressList.getMemoryRecordByDescription("대지 룬작 매크로")

local scriptRec2
if existingRecord then
  scriptRec2 = existingRecord
else
  scriptRec2 = addressList.createMemoryRecord()
  scriptRec2.Description = "대지 룬작 매크로"
  scriptRec2.Type = vtAutoAssembler
  scriptRec2.Script = [[
[ENABLE]
[DISABLE]
]]
end

scriptRec2.OnActivate = function(mr, before, currentstate)
  if running2 then return true end
  running2 = true
  roundsCompleted = {}
  firstRoundDetected = false
  startRound = -1
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  macroTimer2.setEnabled(true)
  showMessage("대지 룬작 매크로 실행")
  return true
end

scriptRec2.OnDeactivate = function(mr, before, currentstate)
  if not running2 then return true end
  running2 = false
  macroTimer2.setEnabled(false)
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  roundsCompleted = {}
  firstRoundDetected = false
  startRound = -1
  showMessage("대지 룬작 매크로 중단")
  return true
end
</LuaScript>
</CheatTable>
