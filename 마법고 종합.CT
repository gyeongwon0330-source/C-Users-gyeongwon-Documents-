      <Color>000080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[enable]
pb+751:
db 00
[disable]
pb+751:
db 01

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>43965</ID>
      <Description>"개박 스캔"</Description>
      <Color>FF0000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[enable]
aobscan(dogAttackrange, 0A D7 23 3C 00 00 80 3F CD CC 4C 3E 35 FA 0E 3E 00 00 C8 42 00 40 1C 46 DB 0F C9 40 E7 E9 1D 42 CD CC 4C 3E 00 00 40 3F 00 00 00 3F 0A D7 23 3C 35)
registersymbol(dogAttackrange)
[disable]



</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>43956</ID>
          <Description>"10만으로 변경"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Float</VariableType>
          <Address>dogAttackrange</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>43791</ID>
          <Description>"개박 적용"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
dogAttackrange:
db 40 50 C3 47   // 100000.5f

{$lua}
createNativeThread(function()
  sleep(30)
  local addr = getAddress('dogAttackrange')
  writeBytes(addr, 0x0A, 0xD7, 0x23, 0x3C)
end)
{$asm}

[DISABLE]
dogAttackrange:
db 0A D7 23 3C   // 0.01f
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
