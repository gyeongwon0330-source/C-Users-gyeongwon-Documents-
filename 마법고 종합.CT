<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"포지션 베이스 스캔"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[enable]
{$lua}
  local results = AOBScan("67 51 92 37 00 01")
  -- aob 스캔

  if results == nil or results.Count == 0 then
  -- 결과가 없는지 확인

    showMessage("AOB 패턴을 찾지 못했습니다.")
    return
  end

  local found = false
  -- 조건을 만족한 주소가 발견되었는지 체크할 변수

  for i = 0, results.Count - 1 do
  -- 검색된 모든 주소에 대해 반복

  local addr = tonumber(results[i], 16)
  -- 첫 번째 주소를 가져옴

  local checkaddr = addr - 0x61C
  -- 현재 주소에서 -0x614에 있는 주소계산

  local val = readFloat(checkaddr)
  -- 그 주소의 float 값을 읽어옴

  if val == -1.0 then
  -- 만약 읽어온 float값이 -1.0이라면, 조건을 만족하는 주소

  pb = addr - 0x8B8
  -- 조건을 만족한 주소에서 -0x894 한 주소를 전역변수 pb에 저장

  PlayerX = pb + 0x18
  PlayerY = pb + 0x1C

  found = true
  break -- 하나만 찾으면 종료
  end
  end

    results.destroy()
  -- 검색 결과 리스트 삭제


    if pb == nil then
    -- 조건을 만족하는 주소가 없으면
     showMessage("포지션베이스를 찾지 못했습니다.")
     return
  end

  local addr = pb + 0x29C
  writeFloat(addr, 99999)
  -- 오프셋 +0x280에 float 99999 값변경


[disable]

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"X 좌표"</Description>
      <ShowAsSigned>0</ShowAsSigned>
      <VariableType>Float</VariableType>
      <Address>pb+18</Address>
    </CheatEntry>
    <CheatEntry>
      <ID>3</ID>
      <Description>"Y 좌표"</Description>
      <ShowAsSigned>0</ShowAsSigned>
      <VariableType>Float</VariableType>
      <Address>pb+1C</Address>
    </CheatEntry>
