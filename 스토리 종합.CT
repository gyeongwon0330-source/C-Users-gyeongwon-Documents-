-- 3라운드: 인식좌표 (10, 62) → 3분 후 (81, 9)
local function handleRound3_Heroes2()
  local myRound = currentActiveRound4
  round1Active = false
  local delayTimer = createTimer()
  delayTimer.Interval = 180000 -- 3분 = 180,000ms
  delayTimer.OnTimer = function(timer)
