  scriptRec3.Description = "아포칼립스 팃노 A 매크로"
  scriptRec3.Type = vtAutoAssembler
  scriptRec3.Script = [[
[ENABLE]
[DISABLE]
]]
end

scriptRec3.OnActivate = function(mr, before, currentstate)
  if running3 then return true end
  running3 = true
  roundsCompleted = {}
  firstRoundDetected = false
  startRound = -1
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  macroTimer3.setEnabled(true)
  showMessage("아포칼립스 팃노 A 매크로 실행")
  return true
end

scriptRec3.OnDeactivate = function(mr, before, currentstate)
  if not running3 then return true end
  running3 = false
  macroTimer3.setEnabled(false)
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  roundsCompleted = {}
  firstRoundDetected = false
  startRound = -1
  showMessage("아포칼립스 팃노 A 매크로 중단")
  return true
end
