if macroTimer3 then
  macroTimer3.destroy()
end

macroTimer3 = createTimer()
macroTimer3.Interval = 100
macroTimer3.Enabled = false

running3 = false
roundsCompleted = {}
firstRoundDetected = false
startRound = -1

-- 좌표 읽기 함수
local function readPosition()
  local posX = readFloat("pb+18")
  local posY = readFloat("pb+1C")
  if posX and posY then
    return posX, posY
  end
  return nil, nil
end

-- 좌표 비교 함수 (정확히 일치할 때만 true)
local function checkCoordinatesExact(targetX, targetY)
  local posX, posY = readPosition()
  if not posX or not posY then
    return false
  end
  return (posX == targetX) and (posY == targetY)
end

-- 좌표 쓰기(바이트로 정확히 기록)
local function writePositionBytes(b1, b2, b3, b4, b5, b6, b7, b8)
  writeBytes("pb+18", b1, b2, b3, b4)
  writeBytes("pb+1C", b5, b6, b7, b8)
end

-- 개박 해제 함수
local function disableDogBurst()
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
end

-- 개박 3초 적용 함수
local function applyDogBurst3Seconds()
  writeBytes("dogAttackrange", 0x40, 0x50, 0xC3, 0x47)

  local disableTimer = createTimer()
  disableTimer.Interval = 3000
  disableTimer.OnTimer = function(t)
    disableDogBurst()
    t.Enabled = false
    t.destroy()
  end
  disableTimer.Enabled = true
end

-- 개박 1ms 간격 10회 실행
local function applyDogBurst10Times()
  local count = 0
  local function doBurst()
    count = count + 1
    writeBytes("dogAttackrange", 0x40, 0x50, 0xC3, 0x47)

    local disableTimer = createTimer()
    disableTimer.Interval = 1
    disableTimer.OnTimer = function(t)
      disableDogBurst()
      t.Enabled = false
      t.destroy()

      if count &lt; 10 then
        local nextTimer = createTimer()
        nextTimer.Interval = 1
        nextTimer.OnTimer = function(t2)
          t2.Enabled = false
          t2.destroy()
          doBurst()
        end
        nextTimer.Enabled = true
      end
    end
    disableTimer.Enabled = true
  end
  doBurst()
end

-- 개박 지속 적용 (특정 좌표 도달 시 해제)
local function applyDogBurstUntil(targetX, targetY)
  writeBytes("dogAttackrange", 0x40, 0x50, 0xC3, 0x47)

  local checkTimer = createTimer()
  checkTimer.Interval = 100
  checkTimer.OnTimer = function(t)
    if checkCoordinatesExact(targetX, targetY) then
      disableDogBurst()
      t.Enabled = false
      t.destroy()
    end
  end
  checkTimer.Enabled = true
end

