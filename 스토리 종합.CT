local function isOnAnyRoundCoord()
  local roundCoords = {
    {56.0, 26.0}, {24.0, 70.0}, {75.0, 105.0}, {171.0, 55.0},
    {27.0, 49.0}, {62.0, 23.0}, {9.0, 52.0}, {70.0, 82.0},
    {68.0, 86.0}, {8.0, 23.0}, {18.0, 15.0}
  }

  for i, coord in ipairs(roundCoords) do
    if checkCoordinates(coord[1], coord[2], 2.0) then
      return true
    end
  end
  return false
end

local function detectRound()
  -- 15, 6 위치 체크 (일시 중단)
  if checkCoordinates(15.0, 6.0, 2.0) then
    if not isPaused then
      isPaused = true
      currentActiveRound = nil
      stationaryStartTime3 = nil
    end
    return true
  else
    if isPaused then
      isPaused = false
    end
  end

  if isPaused then
    return false
  end

  local roundCoords = {
    {56.0, 26.0, "round0", "0 라운드"},
    {24.0, 70.0, "round1", "1 라운드"},
    {75.0, 105.0, "round2_1", "2-1 라운드"},
    {171.0, 55.0, "round2_2", "2-2 라운드"},
    {27.0, 49.0, "defense", "디펜스"},
    {62.0, 23.0, "round3_1", "3-1 라운드"},
    {9.0, 52.0, "round3_2", "3-2 라운드"},
    {70.0, 82.0, "round4_1", "4-1 라운드"},
    {68.0, 86.0, "round4_2", "4-2 라운드"},
    {8.0, 23.0, "round5_1", "5-1 라운드"},
    {18.0, 15.0, "round5_2", "5-2 라운드"}
  }

  for i, data in ipairs(roundCoords) do
    if checkCoordinates(data[1], data[2], 2.0) then
      local roundKey = data[3]
      local currentTime = os.clock()

      if not roundsCompleted3[roundKey] or (currentTime - roundsCompleted3[roundKey] &gt;= 10) then
        roundsCompleted3[roundKey] = currentTime

        currentActiveRound = roundKey
        stationaryStartTime3 = nil

        if roundKey == "round0" then
          handleRound0()
        elseif roundKey == "round1" then
          handleRound1()
        elseif roundKey == "round2_1" then
          handleRound2_1()
        elseif roundKey == "round2_2" then
          handleRound2_2()
        elseif roundKey == "defense" then
          handleDefense()
        elseif roundKey == "round3_1" then
          handleRound3_1()
        elseif roundKey == "round3_2" then
          handleRound3_2()
        elseif roundKey == "round4_1" then
          handleRound4_1()
        elseif roundKey == "round4_2" then
          handleRound4_2()
        elseif roundKey == "round5_1" then
          handleRound5_1()
        elseif roundKey == "round5_2" then
          handleRound5_2()
        end
      end

      return true
    end
  end

  if currentActiveRound and not isOnAnyRoundCoord() then
    local posX, posY = readPosition()

    if posX and posY then
      if lastCheckX3 and lastCheckY3 then
        local diffX = math.abs(posX - lastCheckX3)
        local diffY = math.abs(posY - lastCheckY3)

        if diffX &lt; 0.5 and diffY &lt; 0.5 then
          if not stationaryStartTime3 then
            stationaryStartTime3 = os.clock()
          else
            local stationaryDuration = os.clock() - stationaryStartTime3

            if stationaryDuration &gt;= 7.0 then
              stationaryStartTime3 = os.clock()

              if currentActiveRound == "round0" then
                handleRound0()
              elseif currentActiveRound == "round1" then
                handleRound1()
              elseif currentActiveRound == "round2_1" then
                handleRound2_1()
              elseif currentActiveRound == "round2_2" then
                handleRound2_2()
              elseif currentActiveRound == "defense" then
                handleDefense()
              elseif currentActiveRound == "round3_1" then
                handleRound3_1()
              elseif currentActiveRound == "round3_2" then
                handleRound3_2()
              elseif currentActiveRound == "round4_1" then
                handleRound4_1()
              elseif currentActiveRound == "round4_2" then
                handleRound4_2()
              elseif currentActiveRound == "round5_1" then
                handleRound5_1()
              elseif currentActiveRound == "round5_2" then
                handleRound5_2()
              end
            end
          end
        else
          stationaryStartTime3 = nil
        end
      end

      lastCheckX3 = posX
      lastCheckY3 = posY
    end
  end

  return false
end

macroTimer3.OnTimer = function()
  if not running3 then return end
  detectRound()
end

