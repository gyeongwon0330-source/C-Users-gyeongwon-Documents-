  for i, coord in ipairs(roundCoords) do
    if checkCoordinates(coord[1], coord[2], 2.0) then
      return true
    end
  end
  return false
end

local function detectRound_EP2()
  -- 15, 6 위치 체크 (일시 중단)
  if checkCoordinates(15.0, 6.0, 2.0) then
    if not isPaused4 then
      isPaused4 = true
      currentActiveRound4 = nil
      writeBytes("dogAttackrange", 0x00, 0x00, 0x4A, 0x42)
      stationaryStartTime4 = nil
    end
    return true
  else
    if isPaused4 then
      isPaused4 = false
    end
  end

  if isPaused4 then
    return false
  end

  local roundCoords = {
    {17.0, 19.0, "round0", "0 라운드"},
    {122.0, 23.0, "round1", "1 라운드"},
    {98.0, 89.0, "round2", "2 라운드"},
    {60.0, 14.0, "round3", "3 라운드"},
    {34.0, 64.0, "round4", "4 라운드"}
  }

  for i, data in ipairs(roundCoords) do
    if checkCoordinates(data[1], data[2], 2.0) then
      local roundKey = data[3]
      local currentTime = os.clock()

      if not roundsCompleted4[roundKey] or (currentTime - roundsCompleted4[roundKey] &gt;= 10) then
        roundsCompleted4[roundKey] = currentTime

        writeBytes("dogAttackrange", 0x00, 0x00, 0x48, 0x43)

        currentActiveRound4 = roundKey
        stationaryStartTime4 = nil

        if roundKey == "round0" then
          handleRound0_EP2()
        elseif roundKey == "round1" then
          handleRound1_EP2()
        elseif roundKey == "round2" then
          handleRound2_EP2()
        elseif roundKey == "round3" then
          handleRound3_EP2()
        elseif roundKey == "round4" then
          handleRound4_EP2()
        end
      end

      return true
    end
  end

  if currentActiveRound4 and not isOnAnyRoundCoord_EP2() then
    local posX, posY = readPosition()

    if posX and posY then
      if lastCheckX4 and lastCheckY4 then
        local diffX = math.abs(posX - lastCheckX4)
        local diffY = math.abs(posY - lastCheckY4)

        if diffX &lt; 0.5 and diffY &lt; 0.5 then
          if not stationaryStartTime4 then
            stationaryStartTime4 = os.clock()
          else
            local stationaryDuration = os.clock() - stationaryStartTime4

            if stationaryDuration &gt;= 7.0 then
              stationaryStartTime4 = os.clock()

              if currentActiveRound4 == "round0" then
                handleRound0_EP2()
              elseif currentActiveRound4 == "round1" then
                handleRound1_EP2()
              elseif currentActiveRound4 == "round2" then
                handleRound2_EP2()
              elseif currentActiveRound4 == "round3" then
                handleRound3_EP2()
              elseif currentActiveRound4 == "round4" then
                handleRound4_EP2()
              end
            end
          end
        else
          stationaryStartTime4 = nil
        end
      end

      lastCheckX4 = posX
      lastCheckY4 = posY
    end
  end

  return false
end

macroTimer4.OnTimer = function(timer)
  if not running4 then
    return
  end

  detectRound_EP2()
end

