  <LuaScript>
    <LuaScriptEntry Name=" Script  1 ">-- 전역 변수 초기화
if dogAttackTimer then
  dogAttackTimer.destroy()
end
dogAttackTimer = createTimer()
dogAttackTimer.Interval = 3000  -- 3초마다 실행
dogAttackTimer.Enabled = false
runningDogAttack = false

-- dogAttackrange 토글 함수
local function toggleDogAttack()
  -- ENABLE: 100000.5f 쓰기
  writeBytes("dogAttackrange", 0x40, 0x50, 0xC3, 0x47)
  -- 1ms 후 DISABLE: 0.01f 쓰기
  local disableTimer = createTimer()
  disableTimer.Interval = 1
  disableTimer.OnTimer = function(timer)
    writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
    timer.Enabled = false
    timer.destroy()
  end
  disableTimer.Enabled = true
end

-- 메인 타이머
dogAttackTimer.OnTimer = function()
  if not runningDogAttack then return end
  toggleDogAttack()
end

-- 기존 항목 찾기 (중복 방지)
local addressList = getAddressList()
local existingRecord = addressList.getMemoryRecordByDescription("개박좌표 매크로")

-- 기존 항목이 있으면 재사용, 없으면 새로 생성
local scriptRec3
if existingRecord then
  scriptRec3 = existingRecord
else
  scriptRec3 = addressList.createMemoryRecord()
  scriptRec3.Description = "개박좌표 매크로"
  scriptRec3.Type = vtAutoAssembler
  scriptRec3.Script = [[
[ENABLE]
[DISABLE]
]]
end

scriptRec3.OnActivate = function(mr, before, currentstate)
  if runningDogAttack then return true end
  runningDogAttack = true
  dogAttackTimer.setEnabled(true)
  showMessage("개박좌표 매크로 실행")
  return true
end

scriptRec3.OnDeactivate = function(mr, before, currentstate)
  if not runningDogAttack then return true end
  runningDogAttack = false
  dogAttackTimer.setEnabled(false)
  -- 종료 시 기본값으로 복원
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  showMessage("개박좌표 매크로 중단")
  return true
end
</LuaScriptEntry>
    <LuaScriptEntry Name=" Script  5 ">if macroTimer2 then
  macroTimer2.destroy()
end

macroTimer2 = createTimer()
macroTimer2.Interval = 100
macroTimer2.Enabled = false

running2 = false
roundsCompleted = {}
isPaused = false
currentActiveRound = nil
lastCheckX2 = nil
lastCheckY2 = nil
stationaryStartTime2 = nil
wasOnRound4Coord = false

local function readPosition()
  local posX = readFloat("pb+18")
  local posY = readFloat("pb+1C")
  return posX, posY
end

local function checkCoordinates(targetX, targetY, tolerance)
  tolerance = tolerance or 2.0
  local posX, posY = readPosition()

  if not posX or not posY then
    return false
  end

  local diffX = math.abs(posX - targetX)
  local diffY = math.abs(posY - targetY)

  return diffX &lt; tolerance and diffY &lt; tolerance
end

local function handleRound0()
  local myRound = currentActiveRound
  local delayTimer = createTimer()
  delayTimer.Interval = 1000
  delayTimer.OnTimer = function(timer)
    if not running2 then timer.destroy() return end
    if myRound ~= currentActiveRound then timer.destroy() return end
    if isPaused then timer.destroy() return end
    writeBytes("pb+18", 0x00, 0x00, 0xF0, 0x41)
    writeBytes("pb+1C", 0x00, 0x00, 0xF8, 0x41)
    timer.Enabled = false
    timer.destroy()
  end
  delayTimer.Enabled = true
end

local function handleRound1()
  local myRound = currentActiveRound
  local delayTimer = createTimer()
  delayTimer.Interval = 1000
  delayTimer.OnTimer = function(timer)
    if not running2 then timer.destroy() return end
    if myRound ~= currentActiveRound then timer.destroy() return end
    if isPaused then timer.destroy() return end
    writeBytes("pb+18", 0x00, 0x00, 0x36, 0x43)
    writeBytes("pb+1C", 0x00, 0x00, 0xEA, 0x42)
    timer.Enabled = false
    timer.destroy()
  end
  delayTimer.Enabled = true
end

local function handleRound2()
  local myRound = currentActiveRound
  local delayTimer1 = createTimer()
  delayTimer1.Interval = 4500
  delayTimer1.OnTimer = function(timer1)
    if not running2 then timer1.destroy() return end
    if myRound ~= currentActiveRound then timer1.destroy() return end
    if isPaused then timer1.destroy() return end
    writeBytes("pb+18", 0x00, 0x00, 0xC0, 0x42)
    writeBytes("pb+1C", 0x00, 0x00, 0xF0, 0x41)
    timer1.Enabled = false
    timer1.destroy()

    local delayTimer2 = createTimer()
    delayTimer2.Interval = 500
    delayTimer2.OnTimer = function(timer2)
      if not running2 then timer2.destroy() return end
      if myRound ~= currentActiveRound then timer2.destroy() return end
      if isPaused then timer2.destroy() return end
      writeBytes("pb+18", 0x00, 0x00, 0xCE, 0x42)
      writeBytes("pb+1C", 0x00, 0x00, 0x10, 0x41)
      timer2.Enabled = false
      timer2.destroy()
    end
    delayTimer2.Enabled = true
  end
  delayTimer1.Enabled = true
end

local function handleRound3()
  local myRound = currentActiveRound

  local keyPositions = {
    {0x00, 0x00, 0x88, 0x41, 0x00, 0x00, 0x9E, 0x42},
    {0x00, 0x00, 0x40, 0x41, 0x00, 0x00, 0x60, 0x42},
    {0x00, 0x00, 0x40, 0x41, 0x00, 0x00, 0xB8, 0x41},
    {0x00, 0x00, 0x24, 0x42, 0x00, 0x00, 0x1C, 0x42},
    {0x00, 0x00, 0x86, 0x42, 0x00, 0x00, 0xC0, 0x41},
    {0x00, 0x00, 0x7C, 0x42, 0x00, 0x00, 0x5C, 0x42},
    {0x00, 0x00, 0xA4, 0x42, 0x00, 0x00, 0x74, 0x42}
  }

  local goalPos = {0x00, 0x00, 0x18, 0x42, 0x00, 0x00, 0x40, 0x41}

  local function moveToKey(index)
    if index &gt; #keyPositions then return end
    if not running2 then return end
    if myRound ~= currentActiveRound then return end
    if isPaused then return end

    local pos = keyPositions[index]
    writeBytes("pb+18", pos[1], pos[2], pos[3], pos[4])
    writeBytes("pb+1C", pos[5], pos[6], pos[7], pos[8])

    if index &gt;= 2 then
      local goalTimer = createTimer()
      goalTimer.Interval = 300
      goalTimer.OnTimer = function(timer)
        if not running2 then timer.destroy() return end
        if myRound ~= currentActiveRound then timer.destroy() return end
        if isPaused then timer.destroy() return end
        writeBytes("pb+18", goalPos[1], goalPos[2], goalPos[3], goalPos[4])
        writeBytes("pb+1C", goalPos[5], goalPos[6], goalPos[7], goalPos[8])
        timer.Enabled = false
        timer.destroy()

        if index &lt; #keyPositions then
          local nextTimer = createTimer()
          nextTimer.Interval = 200
          nextTimer.OnTimer = function(timer2)
            if not running2 then timer2.destroy() return end
            if myRound ~= currentActiveRound then timer2.destroy() return end
            if isPaused then timer2.destroy() return end
            moveToKey(index + 1)
            timer2.Enabled = false
            timer2.destroy()
          end
          nextTimer.Enabled = true
        end
      end
      goalTimer.Enabled = true
    else
      local nextTimer = createTimer()
      nextTimer.Interval = 200
      nextTimer.OnTimer = function(timer)
        if not running2 then timer.destroy() return end
        if myRound ~= currentActiveRound then timer.destroy() return end
        if isPaused then timer.destroy() return end
        moveToKey(index + 1)
        timer.Enabled = false
        timer.destroy()
      end
      nextTimer.Enabled = true
    end
  end

  local startTimer = createTimer()
  startTimer.Interval = 4500
  startTimer.OnTimer = function(timer)
    if not running2 then timer.destroy() return end
    if myRound ~= currentActiveRound then timer.destroy() return end
    if isPaused then timer.destroy() return end
    moveToKey(1)
    timer.Enabled = false
    timer.destroy()
  end
  startTimer.Enabled = true
end

local function handleRound4()
  local myRound = currentActiveRound

  local delayTimer1 = createTimer()
  delayTimer1.Interval = 1000
  delayTimer1.OnTimer = function(timer)
    if not running2 then timer.destroy() return end
    if myRound ~= currentActiveRound then timer.destroy() return end
    if isPaused then timer.destroy() return end
    writeBytes("pb+18", 0x00, 0xC0, 0x79, 0x44)
    writeBytes("pb+1C", 0x00, 0xC0, 0x79, 0x44)
    timer.Enabled = false
    timer.destroy()
  end
  delayTimer1.Enabled = true

  local delayTimer2 = createTimer()
  delayTimer2.Interval = 4500
  delayTimer2.OnTimer = function(timer)
    if not running2 then timer.destroy() return end
    if myRound ~= currentActiveRound then timer.destroy() return end
    if isPaused then timer.destroy() return end
    writeBytes("pb+18", 0x00, 0xC0, 0x79, 0x44)
    writeBytes("pb+1C", 0x00, 0xC0, 0x79, 0x44)
    timer.Enabled = false
    timer.destroy()
  end
  delayTimer2.Enabled = true
end

local function isOnAnyRoundCoord()
  local roundCoords = {
    {29.0, 18.0}, {46.0, 33.0}, {86.0, 54.0}, {71.0, 87.0}, {14.0, 22.0}
  }

  for i, coord in ipairs(roundCoords) do
    if checkCoordinates(coord[1], coord[2], 2.0) then
      return true
    end
  end
  return false
end

local function detectRound()
  -- 15, 6 위치 체크 (일시 중단)
  if checkCoordinates(15.0, 6.0, 2.0) then
    if not isPaused then
      isPaused = true
      currentActiveRound = nil
      writeBytes("dogAttackrange", 0x00, 0x00, 0x4A, 0x42)
      stationaryStartTime2 = nil
    end
    return true
  else
    if isPaused then
      isPaused = false
    end
  end

  if isPaused then
    return false
  end

  local roundCoords = {
    {29.0, 18.0, "round0", "0 라운드"},
    {46.0, 33.0, "round1", "1 라운드"},
    {86.0, 54.0, "round2", "2 라운드"},
    {71.0, 87.0, "round3", "3 라운드"},
    {14.0, 22.0, "round4", "4 라운드"}
  }

  for i, data in ipairs(roundCoords) do
    if checkCoordinates(data[1], data[2], 2.0) then
      local roundKey = data[3]
      local currentTime = os.clock()

      -- 4라운드 특별 처리: 좌표 벗어났다가 돌아오면 쿨타임 리셋
      if roundKey == "round4" then
        if not wasOnRound4Coord then
          roundsCompleted[roundKey] = nil
          wasOnRound4Coord = true
        end
      end

      if not roundsCompleted[roundKey] or (currentTime - roundsCompleted[roundKey] &gt;= 10) then
        roundsCompleted[roundKey] = currentTime

        writeBytes("dogAttackrange", 0x00, 0x00, 0x4A, 0x42)

        currentActiveRound = roundKey
        stationaryStartTime2 = nil

        if roundKey == "round0" then
          handleRound0()
        elseif roundKey == "round1" then
          handleRound1()
        elseif roundKey == "round2" then
          handleRound2()
        elseif roundKey == "round3" then
          handleRound3()
        elseif roundKey == "round4" then
          handleRound4()
        end
      end

      return true
    end
  end

  -- 4라운드 좌표에서 벗어남
  if wasOnRound4Coord and not checkCoordinates(14.0, 22.0, 2.0) then
    wasOnRound4Coord = false
  end

  if currentActiveRound and not isOnAnyRoundCoord() then
    local posX, posY = readPosition()

    if posX and posY then
      if lastCheckX2 and lastCheckY2 then
        local diffX = math.abs(posX - lastCheckX2)
        local diffY = math.abs(posY - lastCheckY2)

        if diffX &lt; 0.5 and diffY &lt; 0.5 then
          if not stationaryStartTime2 then
            stationaryStartTime2 = os.clock()
          else
            local stationaryDuration = os.clock() - stationaryStartTime2

            if stationaryDuration &gt;= 7.0 then
              stationaryStartTime2 = os.clock()

              if currentActiveRound == "round0" then
                handleRound0()
              elseif currentActiveRound == "round1" then
                handleRound1()
              elseif currentActiveRound == "round2" then
                handleRound2()
              elseif currentActiveRound == "round3" then
                handleRound3()
              elseif currentActiveRound == "round4" then
                handleRound4()
              end
            end
          end
        else
          stationaryStartTime2 = nil
        end
      end

      lastCheckX2 = posX
      lastCheckY2 = posY
    end
  end

  return false
end

macroTimer2.OnTimer = function(timer)
  if not running2 then
    return
  end

  detectRound()
end

local al = getAddressList()
local existingRecord = al.getMemoryRecordByDescription("EP1 이동 매크로")

local scriptRec2
if existingRecord then
  scriptRec2 = existingRecord
else
  scriptRec2 = al.createMemoryRecord()
  scriptRec2.Description = "EP1 이동 매크로"
  scriptRec2.Type = vtAutoAssembler
  scriptRec2.Script = [[
[ENABLE]

[DISABLE]
]]
end

scriptRec2.OnActivate = function(mr, before, currentstate)
  if running2 then return true end
  running2 = true
  roundsCompleted = {}
  isPaused = false
  currentActiveRound = nil
  lastCheckX2 = nil
  lastCheckY2 = nil
  stationaryStartTime2 = nil
  wasOnRound4Coord = false
  macroTimer2.setEnabled(true)
  showMessage("EP1 자동 매크로 실행")
  return true
end

scriptRec2.OnDeactivate = function(mr, before, currentstate)
  if not running2 then return true end
  running2 = false
  macroTimer2.setEnabled(false)
  writeBytes("dogAttackrange", 0x0A, 0xD7, 0x23, 0x3C)
  roundsCompleted = {}
  isPaused = false
  currentActiveRound = nil
  lastCheckX2 = nil
  lastCheckY2 = nil
  stationaryStartTime2 = nil
  wasOnRound4Coord = false
  showMessage("매크로 중단")
  return true
end
