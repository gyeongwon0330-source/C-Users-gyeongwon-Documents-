local function isOnAnyRoundCoord_Heroes2()
  local roundCoords = {
    {21.0, 22.0}, {25.0, 9.0}, {10.0, 62.0},
    {63.0, 17.0}, {8.0, 44.0}
  }

  for i, coord in ipairs(roundCoords) do
    if checkCoordinates(coord[1], coord[2]) then
      return true
