    if myRound ~= currentActiveRound4 then timer.destroy() return end
    if isPaused4 then timer.destroy() return end
    writeBytes("pb+18", 0x00, 0x00, 0xA2, 0x42) -- 81.0
    writeBytes("pb+1C", 0x00, 0x00, 0x10, 0x41) -- 9.0
    timer.Enabled = false
    timer.destroy()
  end
  delayTimer.Enabled = true
end

