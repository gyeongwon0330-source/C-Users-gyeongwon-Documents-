local function readPosition()
  local posX = readFloat("pb+18")
  local posY = readFloat("pb+1C")
  return posX, posY
end

local function checkCoordinates(targetX, targetY, tolerance)
  tolerance = tolerance or 2.0
  local posX, posY = readPosition()

  if not posX or not posY then
    return false
  end

  local diffX = math.abs(posX - targetX)
  local diffY = math.abs(posY - targetY)

  return diffX &lt; tolerance and diffY &lt; tolerance
end

