local function readPosition()
  local posX = readFloat("pb+18")
  local posY = readFloat("pb+1C")
  return posX, posY
end

local function checkCoordinates(targetX, targetY, tolerance)
  local posX, posY = readPosition()

  if not posX or not posY then
    return false
  end

  -- 오차범위 완전히 제거: 정확히 일치해야만 true
  return posX == targetX and posY == targetY
end

-- 개박 설정 함수
local function setGaeBAK(value)
  if value == 200.5 then
    writeBytes("dogAttackrange", 0x00, 0x80, 0x48, 0x43)  -- 200.5
  elseif value == 50.5 then
    writeBytes("dogAttackrange", 0x00, 0x00, 0x4A, 0x42)  -- 50.5
  end
end

-- 0라운드: 인식좌표 (21, 22) → 5초 후 (20, 29)
local function handleRound0_Heroes2()
  local myRound = currentActiveRound4
  local delayTimer = createTimer()
  delayTimer.Interval = 5000
  delayTimer.OnTimer = function(timer)
    if not running4 then timer.destroy() return end
