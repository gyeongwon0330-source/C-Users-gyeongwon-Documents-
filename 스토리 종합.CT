    checkTimer.OnTimer = function(t2)
      if checkCoordinatesExact(25, 39) then
        applyDogBurstUntil(24, 75)
        t2.Enabled = false
        t2.destroy()
      end
    end
    checkTimer.Enabled = true
  end
  delay1.Enabled = true
end

-- 3-5 라운드 처리 (사이키)
local function handleRound3_5()
  local delay1 = createTimer()
  delay1.Interval = 5000
  delay1.OnTimer = function(t)
    -- 사이키 직업선택 도착지점 (40, 118)
    writePositionBytes(0x00, 0x00, 0x20, 0x42, 0x00, 0x00, 0xEC, 0x42)
    t.Enabled = false
    t.destroy()

    local checkTimer = createTimer()
    checkTimer.Interval = 100
    checkTimer.OnTimer = function(t2)
      if checkCoordinatesExact(40, 118) then
        applyDogBurstUntil(27, 78)
        t2.Enabled = false
        t2.destroy()
      end
    end
    checkTimer.Enabled = true
  end
  delay1.Enabled = true
end

-- 4라운드 처리 - 수정된 버전
local function handleRound4()
  local delay1 = createTimer()
  delay1.Interval = 5000
  delay1.OnTimer = function(t)
    -- 4라운드 직업선택 도착지점 (22, 15)
    writePositionBytes(0x00, 0x00, 0xB0, 0x41, 0x00, 0x00, 0x70, 0x41)
    t.Enabled = false
    t.destroy()

    local checkTimer = createTimer()
    checkTimer.Interval = 100
    checkTimer.OnTimer = function(t2)
      if checkCoordinatesExact(21, 49) then
        t2.Enabled = false
        t2.destroy()

        -- (33, 38)로 이동
        writePositionBytes(0x00, 0x00, 0x04, 0x42, 0x00, 0x00, 0x18, 0x42)

        -- 2초 간격으로 8번 이동
        local moveCount = 0
        local moveTimer = createTimer()
        moveTimer.Interval = 2000
        moveTimer.OnTimer = function(t3)
          moveCount = moveCount + 1
          -- 시간끌기 (33, 38)
          writePositionBytes(0x00, 0x00, 0x04, 0x42, 0x00, 0x00, 0x18, 0x42)

          if moveCount &gt;= 8 then
            t3.Enabled = false
            t3.destroy()
          end
        end
        moveTimer.Enabled = true
      end
    end
    checkTimer.Enabled = true
  end
  delay1.Enabled = true
end

-- 라운드 감지 함수
local function detectRound()
  local roundCoords = {
    -- 1라운드
    {66.0, 135.0, 1, "1라운드"},
    -- 2라운드들
    {14.0, 120.0, 21, "2-1 생태"},
    {11.0, 33.0, 22, "2-2 도서관"},
    {31.0, 14.0, 23, "2-3 트센"},
    {23.0, 64.0, 24, "2-4 본관"},
    {15.0, 13.0, 25, "2-5 기숙사"},
    -- 3라운드들
    {130.0, 10.0, 31, "3-1 불새"},
    {33.0, 140.0, 32, "3-2 아쿠아"},
    {16.0, 51.0, 33, "3-3 컴퓨터실"},
    {30.0, 42.0, 34, "3-4 방송실"},
    {49.0, 115.0, 35, "3-5 사이키"},
    -- 4라운드
    {26.0, 12.0, 4, "4라운드"},
  }

  for _, data in ipairs(roundCoords) do
    local x, y, roundNum = data[1], data[2], data[3]
    if checkCoordinatesExact(x, y) then
      if not firstRoundDetected then
        firstRoundDetected = true
        startRound = roundNum
        for r = 1, roundNum - 1 do
          roundsCompleted[r] = true
        end
      end

      local lastKey = "last_" .. roundNum
      local now = os.clock()
      if not roundsCompleted[lastKey] or (now - roundsCompleted[lastKey] &gt;= 10) then
        roundsCompleted[lastKey] = now

        if roundNum == 1 then
          handleRound1()
        elseif roundNum == 21 then
          handleRound2_1()
        elseif roundNum == 22 then
          handleRound2_2()
        elseif roundNum == 23 then
          handleRound2_3()
        elseif roundNum == 24 then
          handleRound2_4()
        elseif roundNum == 25 then
          handleRound2_5()
        elseif roundNum == 31 then
          handleRound3_1()
        elseif roundNum == 32 then
          handleRound3_2()
        elseif roundNum == 33 then
          handleRound3_3()
        elseif roundNum == 34 then
          handleRound3_4()
        elseif roundNum == 35 then
          handleRound3_5()
        elseif roundNum == 4 then
          handleRound4()
          local resetTimer = createTimer()
          resetTimer.Interval = 5000
          resetTimer.OnTimer = function(t)
            roundsCompleted = {}
            firstRoundDetected = false
            startRound = -1
            t.Enabled = false
            t.destroy()
          end
          resetTimer.Enabled = true
        end
      end
      return true
    end
  end
  return false
end

-- 메인 타이머
macroTimer3.OnTimer = function()
  if not running3 then return end

  -- (15, 6) 좌표 체크 - 무조건 개박 해제
  if checkCoordinatesExact(15, 6) then
    disableDogBurst()
  end

  detectRound()
end

-- 기존 항목 찾기 (중복 방지)
